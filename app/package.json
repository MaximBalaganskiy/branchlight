{
  "name": "branchlight",
  "version": "0.1.0",
  "private": true,
  "description": "A local Git client with a graph workspace and dedicated commit window.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "node test/electron-smoke.cjs",
    "pack": "npm run build && electron-builder --win portable",
    "test:packaged": "node test/electron-smoke.cjs --packaged"
  },
  "dependencies": {
    "@aurelia-ui-toolkits/headless": "1.3.8",
    "@aurelia/dialog": "2.0.0-rc.2",
    "@aurelia/runtime-html": "2.0.0-rc.2",
    "@aurelia/validation": "2.0.0-rc.2",
    "@aurelia/validation-html": "2.0.0-rc.2",
    "aurelia": "2.0.0-rc.2",
    "dugite": "3.2.3",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@aurelia/vite-plugin": "2.0.0-rc.2",
    "@types/node": "^24.0.0",
    "electron": "44.7.1",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "local.branchlight.app",
    "productName": "Branchlight",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/dugite/git/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "dugite@3.2.3": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
